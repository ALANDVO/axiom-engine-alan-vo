# App
APP_NAME=axiom-engine
APP_VERSION=1.0.0
DEBUG=false
DEMO_MODE=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/axiom.db

# Keycloak OIDC (required for production)
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=axiom-engine
KEYCLOAK_CLIENT_ID=axiom-engine-client
KEYCLOAK_CLIENT_SECRET=

# LLM (optional - for server-side LLM calls)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Routing
DEFAULT_ROUTING_STRATEGY=round_robin
HEALTH_CHECK_INTERVAL_SECONDS=60
PROBE_ENABLED=false

# Concurrency
MAX_CONCURRENT_REQUESTS_PER_KEY=10
HEDGE_AFTER_MS=0

# CORS
CORS_ORIGINS=http://localhost:5173